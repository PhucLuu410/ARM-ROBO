{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build STM32",
            "type": "shell",
            "command": "make",
            "args": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Kill OpenOCD",
            "type": "shell",
            "command": "taskkill /f /im openocd.exe",
            "problemMatcher": []
        },
        {
            "label": "Build C++ App",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "Load_Firmware.cpp",
                "-o",
                "Load_Firmware.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}